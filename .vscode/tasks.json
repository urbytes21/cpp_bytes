{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build Scratch Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug",
                "--target",
                "scratch_debug"
            ],
            "dependsOn": "CMake Debug Configure",
            "problemMatcher": "$gcc",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "CMake Debug Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/debug",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "CMake Debug Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem"
            },
            "dependsOn": "CMake Debug Configure",
            "problemMatcher": "$gcc"
        }
    ]
}
